00001bda <CmdDisplay>:
    // Setze die DDRAM-Adresse basierend auf Zeile und Spalte
    CmdDisplay(CMD_SET_DDRAM_ADRESS + (0x10 * zeile) + spalte);

    // Sende die Character-Adresse an das Display
    DataDisplay(charAddress);
}
